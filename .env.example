# Store your own credentials privately. This template contains no credentials.
OPENAI_API_KEY=

# Verified full-public host values with optional reserved judge capacity.
# Public model attempts per UTC day: integer 1–360, default 36; selected host value 180.
# Guest Luna interactions per browser session per UTC day: integer 1–60, default 4; host value 24.
# Existing counters survive configuration changes. These are attempt caps, not currency caps.
# REELBALANCE_OPENAI_DAILY_LIMIT=180
# REELBALANCE_GUEST_DAILY_LIMIT=24

# Optional extra capacity for authenticated judges and organisers: model pool default 240.
# Public visitors cannot spend reserved pools and authenticated users bypass guest caps.
# All provider access retains shared pauses and a single global provider-operation lock.
# REELBALANCE_OPENAI_JUDGE_DAILY_LIMIT=240
# REELBALANCE_JUDGE_USERNAME=judge
# REELBALANCE_JUDGE_PASSWORD=<private random 32-byte secret encoded as base64url or hex>

# Loopback is the default. Synthetic fixtures enable only the manual planner.
# REELBALANCE_DATASET_PATH=/absolute/path/to/your/private/dataset.json
# REELBALANCE_RECORDING_PATH=/absolute/path/to/your/private/recording.json

# Genuine-evidence live Qloo collection uses the official harness's private config.
# Full anonymous custom workflow requires REELBALANCE_PUBLIC_CUSTOM=1 and a signed browser session.
# Separate Qloo daily attempt pools: public host value 120; reserved host value 60.
# Guest Qloo attempts per browser session per UTC day: integer 1–60, default 12; host value 12.
# Qloo provider-pool settings accept 1–120 and default to 12 when unset.
# At least 60 seconds between attempts; no automatic retries; existing counts are retained.
# REELBALANCE_QLOO_LIVE=1
# REELBALANCE_PUBLIC_CUSTOM=1
# REELBALANCE_PUBLIC_QLOO_DAILY_LIMIT=120
# REELBALANCE_GUEST_QLOO_DAILY_LIMIT=12
# REELBALANCE_QLOO_DAILY_LIMIT=60

# Shared private cache: 8 MiB, 1200 searches, 600 selections, 1200 rankings.
# Public admission: 1000 searches, 500 selections, 1000 rankings; existing evidence retained.

# Public hosting requires an exact HTTPS origin and the server's public access controls.
# Owner administration and provider credentials remain private; public workflows need no login.
# HOST=0.0.0.0
# REELBALANCE_ACCESS_MODE=public
# APP_ORIGIN=https://your-app.example
# REELBALANCE_OWNER_TOKEN=
